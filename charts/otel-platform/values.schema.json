{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "gateway_topology": {
      "enum": [
        "unified",
        "dual"
      ]
    },
    "metrics_protocol": {
      "enum": [
        "otlp_http",
        "otlp_grpc",
        "prometheus_remote_write"
      ]
    },
    "trace_protocol": {
      "enum": [
        "otlp_http",
        "otlp_grpc"
      ]
    },
    "log_protocol": {
      "enum": [
        "otlp_http",
        "otlp_grpc"
      ]
    },
    "image_pull_secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "target_allocator_memory_mib": {
      "type": "integer",
      "minimum": 256
    },
    "gateway_replicas": {
      "type": "integer",
      "minimum": 1
    },
    "log_gateway_replicas": {
      "type": "integer",
      "minimum": 1
    },
    "scraper_replicas": {
      "type": "integer",
      "minimum": 1
    },
    "collector_memory_mib": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateway",
        "logs",
        "node",
        "cluster",
        "scraper",
        "sampler"
      ],
      "properties": {
        "gateway": {
          "type": "integer",
          "minimum": 256
        },
        "logs": {
          "type": "integer",
          "minimum": 256
        },
        "node": {
          "type": "integer",
          "minimum": 256
        },
        "cluster": {
          "type": "integer",
          "minimum": 256
        },
        "scraper": {
          "type": "integer",
          "minimum": 256
        },
        "sampler": {
          "type": "integer",
          "minimum": 256
        }
      }
    },
    "cluster_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "exporter_queue_mib": {
      "type": "integer",
      "minimum": 1
    },
    "otlp_max_recv_mib": {
      "type": "integer",
      "minimum": 1
    },
    "filelog_start_at": {
      "enum": [
        "beginning",
        "end"
      ]
    },
    "filelog_max_log_size": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(KiB|MiB)$"
    },
    "target_allocator_mtls": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "useCertManager": {
          "type": "boolean"
        },
        "tls": {
          "type": "object"
        }
      }
    },
    "exporter_batch_max_kib": {
      "type": "integer",
      "minimum": 8
    },
    "log_processing": {
      "type": "object",
      "required": [
        "filelog",
        "kubernetes",
        "resource",
        "normalize"
      ],
      "properties": {
        "filelog": {
          "type": "object",
          "required": [
            "container",
            "source",
            "recombine",
            "cleanup"
          ],
          "properties": {
            "recombine": {
              "type": "object",
              "required": [
                "if",
                "is_first_entry",
                "max_sources",
                "max_log_size",
                "max_batch_size",
                "force_flush_period"
              ],
              "properties": {
                "if": {
                  "type": "string"
                },
                "is_first_entry": {
                  "type": "string"
                },
                "max_sources": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 512
                },
                "max_log_size": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 1048576
                },
                "max_batch_size": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1024
                }
              }
            }
          }
        },
        "application_time": {
          "type": "object",
          "required": [
            "enabled",
            "layout",
            "timezone"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "layout": {
              "type": "string",
              "minLength": 1
            },
            "timezone": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "trace_processing": {
      "type": "object",
      "required": [
        "drop_noise",
        "noise_filter",
        "redact",
        "normalize"
      ],
      "properties": {
        "drop_noise": {
          "type": "boolean"
        }
      }
    },
    "metrics_processing": {
      "type": "object",
      "required": [
        "hostmetrics",
        "kubeletstats",
        "cluster",
        "labels"
      ]
    },
    "resource_attributes": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "storage_class": {
      "type": "string"
    },
    "collector_image": {
      "type": "string"
    },
    "trace_endpoint": {
      "type": "string"
    },
    "log_endpoint": {
      "type": "string"
    },
    "metrics_endpoint": {
      "type": "string"
    },
    "kafka_brokers": {
      "type": "array"
    },
    "kafka_topic": {
      "type": "string"
    },
    "kafka_group": {
      "type": "string"
    },
    "java_image": {
      "type": "string"
    },
    "python_image": {
      "type": "string"
    },
    "nodejs_image": {
      "type": "string"
    },
    "secret_names": {
      "type": "object"
    },
    "backend_ca_file": {
      "type": "string"
    },
    "kafka_tls": {
      "type": "object"
    },
    "kafka_auth": {
      "type": "object"
    },
    "kubelet_ca_file": {
      "type": "string"
    },
    "kubelet_endpoint": {
      "type": "string"
    },
    "target_allocator_image": {
      "type": "string"
    },
    "target_allocator_secret_namespaces": {
      "type": "array"
    },
    "pvc_size": {
      "type": "string"
    },
    "collector_cpu": {
      "type": "object"
    },
    "otlp_namespace_selector": {
      "type": "object"
    },
    "monitor_namespace_selector": {
      "type": "object"
    },
    "businessPodMonitors": {
      "type": "array"
    },
    "credentials": {
      "type": "object"
    },
    "rollout_revision": {
      "type": "string"
    },
    "trace_headers": {
      "type": "object"
    },
    "log_headers": {
      "type": "object"
    },
    "metrics_headers": {
      "type": "object"
    },
    "operator_metrics": {
      "type": "object",
      "required": [
        "enabled",
        "namespace",
        "service",
        "port",
        "server_name",
        "certificate_secret"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "kafka_metrics": {
      "type": "object",
      "required": [
        "enabled",
        "collection_interval"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "collection_interval": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "scheduling": {
      "type": "object"
    },
    "logs_transport": {
      "enum": [
        "direct",
        "kafka"
      ]
    },
    "sampler_replicas": {
      "type": "integer",
      "minimum": 1
    },
    "monitor_resources_enabled": {
      "type": "boolean"
    },
    "scrape_jobs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "log_namespaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "maxLength": 63
      }
    },
    "node_state_directory": {
      "type": "string",
      "pattern": "^/var/lib/otel[-a-zA-Z0-9_/]*$"
    },
    "tail_sampling": {
      "type": "object"
    },
    "aws_sigv4": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "region": {
          "type": "string"
        },
        "service": {
          "enum": [
            "aps"
          ]
        }
      }
    },
    "service_account_annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "persistent_queue": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
